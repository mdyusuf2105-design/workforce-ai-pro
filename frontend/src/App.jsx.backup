import { useCallback, useEffect, useMemo, useState } from "react";
import axios from "axios";
import {
  Activity, Users, Building2, Search, LogOut,
  LayoutDashboard, ShieldCheck, RefreshCw, UserRound,
  BriefcaseBusiness, AlertCircle, BrainCircuit, History,
  TrendingUp, Clock3, ChartNoAxesCombined, CircleAlert, CalendarCheck, LogIn, LogOut as LogOutIcon,
} from "lucide-react";
import {
  ResponsiveContainer, PieChart, Pie, Cell, Tooltip,
  BarChart, Bar, XAxis, YAxis, CartesianGrid,
} from "recharts";
import "./App.css";

const API = "http://127.0.0.1:8000/api";
const client = axios.create({ baseURL: API });

client.interceptors.request.use((config) => {
  const token = localStorage.getItem("wf_token");
  if (token) config.headers.Authorization = `Bearer ${token}`;
  return config;
});

const RISK_COLORS = {
  HIGH: "#dc5454",
  MEDIUM: "#e8a33e",
  LOW: "#239b77",
};

function formatDate(value) {
  if (!value) return "—";
  const date = new Date(value);
  return Number.isNaN(date.getTime())
    ? "—"
    : date.toLocaleString(undefined, {
        year: "numeric",
        month: "short",
        day: "numeric",
        hour: "2-digit",
        minute: "2-digit",
      });
}

function riskLabel(value) {
  return String(value || "UNKNOWN").toUpperCase();
}

function App() {
  const [token, setToken] = useState(() => localStorage.getItem("wf_token"));
  const [user, setUser] = useState(null);
  const [employees, setEmployees] = useState([]);
  const [attendanceRecords, setAttendanceRecords] = useState([]);
  const [attendanceSummary, setAttendanceSummary] = useState(null);
  const [attendanceLoading, setAttendanceLoading] = useState(false);
  const [attendanceMessage, setAttendanceMessage] = useState("");
  const [attendanceError, setAttendanceError] = useState("");
  const [attendanceEmployeeId, setAttendanceEmployeeId] = useState("");

  const [predictions, setPredictions] = useState([]);
  const [search, setSearch] = useState("");
  const [authMode, setAuthMode] = useState("login");
  const [recoveryEmail, setRecoveryEmail] = useState("");
  const [resetToken, setResetToken] = useState("");
  const [newPassword, setNewPassword] = useState("");
  const [loading, setLoading] = useState(false);
  const [authLoading, setAuthLoading] = useState(false);
  const [error, setError] = useState("");
  const [notice, setNotice] = useState("");
  const [activeView, setActiveView] = useState("dashboard");
  const [showPredictionForm, setShowPredictionForm] = useState(false);
  const [selectedEmployeeId, setSelectedEmployeeId] = useState("");
  const [predictionInputs, setPredictionInputs] = useState({
    overtime: false,
    job_satisfaction: 3,
    work_life_balance: 3,
    years_at_company: 3,
    monthly_income: 50000,
    training_hours: 20,
  });
  const [predictionLoading, setPredictionLoading] = useState(false);
  const [predictionResult, setPredictionResult] = useState(null);
  const [predictionError, setPredictionError] = useState("");
  const [credentials, setCredentials] = useState({
    full_name: "",
    email: "",
    password: "",
  });

  const loadDashboard = useCallback(async () => {
    if (!token) return;

    setLoading(true);
    setError("");

    try {
      const [profileResponse, employeeResponse] = await Promise.all([
        client.get("/auth/me"),
        client.get("/employees/", {
          params: { search: search || undefined, limit: 100 },
        }),
      ]);

      setUser(profileResponse.data);
      setEmployees(Array.isArray(employeeResponse.data) ? employeeResponse.data : []);

      const role = String(profileResponse.data?.role || "").toUpperCase();

      if (["ADMIN", "HR"].includes(role)) {
        try {
          const historyResponse = await client.get("/attrition/history", {
            params: { limit: 200 },
          });
          setPredictions(
            Array.isArray(historyResponse.data) ? historyResponse.data : []
          );
        } catch (historyError) {
          setPredictions([]);
          if (historyError.response?.status === 401) {
            setError("Your session has expired. Please sign in again.");
          } else if (historyError.response?.status === 403) {
            setError("Your account cannot access prediction history.");
          } else {
            setError(
              historyError.response?.data?.detail ||
              "Could not load attrition history. Check the backend."
            );
          }
        }
      } else {
        setPredictions([]);
      }
    } catch (err) {
      const status = err.response?.status;
      if (status === 401) {
        localStorage.removeItem("wf_token");
        setToken(null);
        setUser(null);
        setEmployees([]);
        setPredictions([]);
        setError("Your session expired. Please log in again.");
      } else {
        setError(
          err.response?.data?.detail ||
          "Unable to load the dashboard. Check that the backend is running."
        );
      }
    } finally {
      setLoading(false);
    }
  }, [token, search]);

  useEffect(() => {
    if (token) loadDashboard();
  }, [token, loadDashboard]);


  const loadAttendance = useCallback(async () => {
    if (!token) return;

    setAttendanceLoading(true);
    setAttendanceError("");
    setAttendanceMessage("");

    try {
      const response = await client.get("/attendance/", {
        params: { limit: 500 },
      });

      const records = Array.isArray(response.data) ? response.data : [];
      setAttendanceRecords(records);

      try {
        const summaryResponse = await client.get("/attendance/summary");
        setAttendanceSummary(summaryResponse.data);
      } catch {
        // The summary endpoint is restricted to Admin, HR, and Manager.
        setAttendanceSummary(null);
      }
    } catch (err) {
      setAttendanceError(
        err.response?.data?.detail || "Unable to load attendance records."
      );
    } finally {
      setAttendanceLoading(false);
    }
  }, [token]);

  useEffect(() => {
    if (token && activeView === "attendance") {
      loadAttendance();
    }
  }, [token, activeView, loadAttendance]);

  async function recordAttendance(action) {
    if (!attendanceEmployeeId) {
      setAttendanceError("Please select an employee first.");
      return;
    }

    setAttendanceLoading(true);
    setAttendanceError("");
    setAttendanceMessage("");

    try {
      await client.post(`/attendance/${action}`, {
        employee_id: Number(attendanceEmployeeId),
      });

      setAttendanceMessage(
        action === "check-in"
          ? "Check-in recorded successfully."
          : "Check-out recorded successfully."
      );

      await loadAttendance();
      await loadDashboard();
    } catch (err) {
      setAttendanceError(
        err.response?.data?.detail || "Unable to record attendance."
      );
    } finally {
      setAttendanceLoading(false);
    }
  }

  async function handleAuth(event) {
    event.preventDefault();
    setAuthLoading(true);
    setError("");
    setNotice("");

    try {
      if (authMode === "register") {
        await axios.post(`${API}/auth/register`, {
          full_name: credentials.full_name,
          email: credentials.email,
          password: credentials.password,
        });
        setNotice("Account created. You can now sign in.");
        setAuthMode("login");
        setCredentials((previous) => ({
          ...previous,
          password: "",
        }));
      } else {
        const response = await axios.post(`${API}/auth/login`, {
          email: credentials.email,
          password: credentials.password,
        });
        localStorage.setItem("wf_token", response.data.access_token);
        setToken(response.data.access_token);
      }
    } catch (err) {
      setError(
        err.response?.data?.detail ||
        "Request failed. Make sure the backend is running."
      );
    } finally {
      setAuthLoading(false);
    }
  }

  async function handleForgotPassword(event) {
    event.preventDefault();
    setAuthLoading(true);
    setError("");
    setNotice("");
    setResetToken("");

    try {
      const response = await axios.post(`${API}/auth/forgot-password`, {
        email: recoveryEmail.trim(),
      });

      setNotice(response.data.message || "If an active account exists, a reset can be initiated.");

      if (response.data.reset_token) {
        setResetToken(response.data.reset_token);
        setAuthMode("reset");
        setNotice(
          "Development/testing mode: your reset token is shown below. It expires in 15 minutes."
        );
      }
    } catch (err) {
      setError(
        err.response?.data?.detail ||
        "Unable to start password recovery. Check that the backend is running."
      );
    } finally {
      setAuthLoading(false);
    }
  }

  async function handleResetPassword(event) {
    event.preventDefault();
    setAuthLoading(true);
    setError("");
    setNotice("");

    try {
      const response = await axios.post(`${API}/auth/reset-password`, {
        token: resetToken.trim(),
        new_password: newPassword,
      });

      setNotice(
        response.data.message ||
        "Password reset successfully. Please sign in with your new password."
      );
      setAuthMode("login");
      setCredentials((previous) => ({
        ...previous,
        email: recoveryEmail.trim(),
        password: "",
      }));
      setResetToken("");
      setNewPassword("");
    } catch (err) {
      setError(
        err.response?.data?.detail ||
        "Unable to reset your password. Check the token and try again."
      );
    } finally {
      setAuthLoading(false);
    }
  }

  async function submitAttritionPrediction(event) {
    event.preventDefault();
    setPredictionLoading(true);
    setPredictionError("");
    setPredictionResult(null);
    setError("");

    try {
      const response = await client.post(
        "/attrition/predict",
        {
          overtime: predictionInputs.overtime,
          job_satisfaction: Number(predictionInputs.job_satisfaction),
          work_life_balance: Number(predictionInputs.work_life_balance),
          years_at_company: Number(predictionInputs.years_at_company),
          monthly_income: Number(predictionInputs.monthly_income),
          training_hours: Number(predictionInputs.training_hours),
        },
        { params: { employee_id: Number(selectedEmployeeId) } }
      );

      setPredictionResult(response.data);
      await loadDashboard();
    } catch (err) {
      setPredictionError(
        err.response?.data?.detail ||
        "Prediction failed. Check your inputs and backend connection."
      );
    } finally {
      setPredictionLoading(false);
    }
  }

  function logout() {
    localStorage.removeItem("wf_token");
    setToken(null);
    setUser(null);
    setEmployees([]);
    setPredictions([]);
    setCredentials({ full_name: "", email: "", password: "" });
    setError("");
    setNotice("");
    setActiveView("dashboard");
  }

  const departments = useMemo(
    () => new Set(employees.map((employee) => employee.department).filter(Boolean)).size,
    [employees]
  );

  const activeCount = useMemo(
    () => employees.filter((employee) => employee.employment_status === "ACTIVE").length,
    [employees]
  );

  const riskCounts = useMemo(() => {
    const counts = { HIGH: 0, MEDIUM: 0, LOW: 0 };
    predictions.forEach((prediction) => {
      const level = riskLabel(prediction.risk_level);
      if (Object.hasOwn(counts, level)) counts[level] += 1;
    });
    return counts;
  }, [predictions]);

  const riskChartData = useMemo(
    () => [
      { name: "High risk", level: "HIGH", value: riskCounts.HIGH },
      { name: "Medium risk", level: "MEDIUM", value: riskCounts.MEDIUM },
      { name: "Low risk", level: "LOW", value: riskCounts.LOW },
    ],
    [riskCounts]
  );

  const historyChartData = useMemo(() => {
    const buckets = new Map();
    [...predictions].reverse().forEach((prediction) => {
      const date = new Date(prediction.created_at);
      if (Number.isNaN(date.getTime())) return;
      const key = date.toLocaleDateString(undefined, {
        month: "short",
        day: "numeric",
      });
      if (!buckets.has(key)) {
        buckets.set(key, { date: key, HIGH: 0, MEDIUM: 0, LOW: 0 });
      }
      const level = riskLabel(prediction.risk_level);
      if (Object.hasOwn(buckets.get(key), level)) buckets.get(key)[level] += 1;
    });
    return Array.from(buckets.values()).slice(-7);
  }, [predictions]);

  const isAnalyticsRole = ["ADMIN", "HR"].includes(
    String(user?.role || "").toUpperCase()
  );

  if (!token) {
    return (
      <main className="auth-page">
        <section className="auth-visual">
          <div className="brand">
            <span className="brand-mark">W</span> Workforce AI Pro
          </div>
          <div className="visual-copy">
            <span className="eyebrow">WORKFORCE INTELLIGENCE PLATFORM</span>
            <h1>Understand your people. Build a stronger workforce.</h1>
            <p>
              Bring employee management and workforce intelligence into one
              secure workspace.
            </p>
            <div className="visual-stats">
              <div><ShieldCheck size={20} /><span>Secure access</span></div>
              <div><Activity size={20} /><span>Workforce analytics</span></div>
            </div>
          </div>
          <span className="visual-footer">
            Workforce intelligence for better decisions.
          </span>
        </section>

        <section className="auth-panel">
          {authMode === "forgot" || authMode === "reset" ? (
            <form
              className="auth-form"
              onSubmit={authMode === "forgot" ? handleForgotPassword : handleResetPassword}
            >
              <div className="mobile-brand">WorkForce AI Pro</div>
              <span className="eyebrow">ACCOUNT RECOVERY</span>

              {authMode === "forgot" ? (
                <>
                  <h2>Forgot your password?</h2>
                  <p className="muted">
                    Enter your registered email to initiate password recovery.
                  </p>

                  <label>Email address
                    <input
                      type="email"
                      required
                      autoComplete="email"
                      value={recoveryEmail}
                      onChange={(event) => setRecoveryEmail(event.target.value)}
                      placeholder="you@company.com"
                    />
                  </label>

                  {error && (
                    <div className="alert error">
                      <AlertCircle size={17} />{String(error)}
                    </div>
                  )}
                  {notice && <div className="alert success">{notice}</div>}

                  <button className="primary-btn" disabled={authLoading}>
                    {authLoading ? "Please wait..." : "Continue"}
                  </button>
                </>
              ) : (
                <>
                  <h2>Reset your password</h2>
                  <p className="muted">
                    Enter your reset token and choose a new password of at least 12 characters.
                  </p>

                  {resetToken && (
                    <div className="recovery-token">
                      <strong>Development reset token</strong>
                      <textarea
                        aria-label="Development reset token"
                        readOnly
                        rows={3}
                        value={resetToken}
                        onClick={(event) => event.currentTarget.select()}
                      />
                      <small>Copy this token into the field below. It expires in 15 minutes.</small>
                    </div>
                  )}

                  <label>Reset token
                    <textarea
                      required
                      rows={3}
                      value={resetToken}
                      onChange={(event) => setResetToken(event.target.value)}
                      placeholder="Paste your reset token"
                    />
                  </label>

                  <label>New password
                    <input
                      type="password"
                      required
                      minLength={12}
                      maxLength={128}
                      autoComplete="new-password"
                      value={newPassword}
                      onChange={(event) => setNewPassword(event.target.value)}
                      placeholder="At least 12 characters"
                    />
                  </label>

                  {error && (
                    <div className="alert error">
                      <AlertCircle size={17} />{String(error)}
                    </div>
                  )}
                  {notice && <div className="alert success">{notice}</div>}

                  <button className="primary-btn" disabled={authLoading}>
                    {authLoading ? "Please wait..." : "Reset password"}
                  </button>
                </>
              )}

              <p className="switch-auth">
                Remember your password?
                <button
                  type="button"
                  onClick={() => {
                    setAuthMode("login");
                    setError("");
                    setNotice("");
                    setResetToken("");
                    setNewPassword("");
                  }}
                >
                  Back to sign in
                </button>
              </p>
            </form>
          ) : (
          <form className="auth-form" onSubmit={handleAuth}>
            <div className="mobile-brand">WorkForce AI Pro</div>
            <span className="eyebrow">
              {authMode === "login" ? "WELCOME BACK" : "GET STARTED"}
            </span>
            <h2>
              {authMode === "login" ? "Sign in to your account" : "Create your account"}
            </h2>
            <p className="muted">
              {authMode === "login"
                ? "Enter your credentials to continue."
                : "New accounts receive the Employee role by default."}
            </p>

            {authMode === "register" && (
              <label>Full name
                <input
                  required minLength={2} maxLength={120}
                  value={credentials.full_name}
                  onChange={(event) =>
                    setCredentials({ ...credentials, full_name: event.target.value })
                  }
                  placeholder="Your full name"
                />
              </label>
            )}

            <label>Email address
              <input
                type="email" required
                value={credentials.email}
                onChange={(event) =>
                  setCredentials({ ...credentials, email: event.target.value })
                }
                placeholder="you@company.com"
              />
            </label>

            <label>Password
              <input
                type="password" required
                minLength={authMode === "register" ? 12 : 1}
                value={credentials.password}
                onChange={(event) =>
                  setCredentials({ ...credentials, password: event.target.value })
                }
                placeholder={authMode === "register" ? "At least 12 characters" : "Enter your password"}
              />
            </label>

            {authMode === "login" && (
              <p className="forgot-password-link">
                <button
                  type="button"
                  onClick={() => {
                    setRecoveryEmail(credentials.email);
                    setAuthMode("forgot");
                    setError("");
                    setNotice("");
                  }}
                >
                  Forgot password?
                </button>
              </p>
            )}

            {error && <div className="alert error"><AlertCircle size={17} />{String(error)}</div>}
            {notice && <div className="alert success">{notice}</div>}

            <button className="primary-btn" disabled={authLoading}>
              {authLoading
                ? "Please wait..."
                : authMode === "login" ? "Sign in" : "Create account"}
            </button>

            <p className="switch-auth">
              {authMode === "login" ? "Don't have an account?" : "Already registered?"}
              <button
                type="button"
                onClick={() => {
                  setAuthMode(authMode === "login" ? "register" : "login");
                  setError("");
                  setNotice("");
                }}
              >
                {authMode === "login" ? "Create account" : "Sign in"}
              </button>
            </p>
          </form>
          )}
        </section>
      </main>
    );
  }

  return (
    <div className="app-shell">
      <aside className="sidebar">
        <div className="brand">
          <span className="brand-mark">W</span>
          <span>WorkForce <small>AI PRO</small></span>
        </div>

        <div className="workspace-label">WORKSPACE</div>
        <button
          className={`nav-item ${activeView === "dashboard" ? "selected" : ""}`}
          onClick={() => setActiveView("dashboard")}
        >
          <LayoutDashboard size={18} />Dashboard
        </button>
        <button
          className={`nav-item ${activeView === "employees" ? "selected" : ""}`}
          onClick={() => setActiveView("employees")}
        >
          <Users size={18} />Employees
        </button>
        <button
          className={`nav-item ${activeView === "departments" ? "selected" : ""}`}
          onClick={() => setActiveView("departments")}
        >
          <Building2 size={18} />Departments
        </button>
        <button
          className={`nav-item ${activeView === "attendance" ? "selected" : ""}`}
          onClick={() => setActiveView("attendance")}
        >
          <CalendarCheck size={18} />Attendance
        </button>
        {isAnalyticsRole && (
          <button
            className={`nav-item ${activeView === "insights" ? "selected" : ""}`}
            onClick={() => setActiveView("insights")}
          >
            <BrainCircuit size={18} />Workforce insights
          </button>
        )}

        <div className="sidebar-bottom">
          <div className="secure-note">
            <ShieldCheck size={17} />
            <span>Authenticated session<br /><small>JWT security enabled</small></span>
          </div>
          <button className="logout-btn" onClick={logout}>
            <LogOut size={17} />Sign out
          </button>
        </div>
      </aside>

      <main className="main-panel">
        <header className="topbar">
          <div><span className="breadcrumb">Workspace /</span> {
            activeView === "insights" ? "Workforce insights" :
            activeView === "attendance" ? "Attendance" :
            activeView === "employees" ? "Employees" :
            activeView === "departments" ? "Departments" : "Dashboard"
          }</div>
          <div className="profile-chip">
            <div className="avatar">
              {user?.full_name?.charAt(0)?.toUpperCase() || "U"}
            </div>
            <div className="profile-details">
              <strong>{user?.full_name || "User"}</strong>
              <span>{user?.role || "EMPLOYEE"}</span>
            </div>
          </div>
        </header>

        <div className="page-content">
          <div className="page-heading">
            <div>
              <span className="eyebrow">
                {activeView === "insights" ? "AI WORKFORCE INTELLIGENCE" : "OVERVIEW"}
              </span>
              <h1>
                {activeView === "insights" ? "Attrition analytics" :
                 activeView === "attendance" ? "Attendance management" :
                 activeView === "employees" ? "Employee directory" :
                 activeView === "departments" ? "Department overview" :
                 "Workforce dashboard"}
              </h1>
              <p className="muted">
                {activeView === "insights"
                  ? "Explore saved experimental attrition predictions."
                  : activeView === "attendance"
                    ? "Record check-ins, check-outs, and review attendance history."
                    : "Monitor employee records and workforce activity."}
              </p>
            </div>
            <button className="secondary-btn" onClick={loadDashboard} disabled={loading}>
              <RefreshCw size={16} className={loading ? "spin" : ""} />
              Refresh
            </button>
          </div>

          {error && <div className="alert error"><AlertCircle size={17} />{String(error)}</div>}

          {activeView === "dashboard" && (
            <>
              <section className="stat-grid">
                <StatCard icon={<Users />} label="Employees loaded" value={employees.length} note="Records returned by API" />
                <StatCard icon={<UserRound />} label="Active employees" value={activeCount} note="Based on employee status" />
                <StatCard icon={<Building2 />} label="Departments" value={departments} note="Unique departments represented" />
                <StatCard icon={<BriefcaseBusiness />} label="Your role" value={user?.role || "—"} note="Access level for this account" />
              </section>

              {isAnalyticsRole && (
                <>
                  <section className="section-title">
                    <div>
                      <h2>Attrition risk overview</h2>
                      <p className="muted">Counts are calculated from saved API predictions.</p>
                    </div>
                    <button className="text-link" onClick={() => setActiveView("insights")}>
                      View analytics <TrendingUp size={15} />
                    </button>
                  </section>
                  <RiskCards counts={riskCounts} total={predictions.length} />
                </>
              )}

              <EmployeeTable employees={employees} loading={loading} search={search} setSearch={setSearch} />

              {isAnalyticsRole && (
                <PredictionHistory predictions={predictions.slice(0, 5)} loading={loading} compact />
              )}
            </>
          )}

          {activeView === "employees" && (
            <>
              {isAnalyticsRole && (
                <section className="prediction-action-panel">
                  <div>
                    <span className="eyebrow">WORKFORCE INTELLIGENCE</span>
                    <h2>Attrition prediction</h2>
                    <p className="muted">
                      Generate an experimental estimate for an employee using the demo model.
                    </p>
                  </div>
                  <button
                    className="primary-btn prediction-open-btn"
                    type="button"
                    onClick={() => {
                      setShowPredictionForm((previous) => !previous);
                      setPredictionError("");
                      setPredictionResult(null);
                      if (!selectedEmployeeId && employees.length) {
                        setSelectedEmployeeId(String(employees[0].id));
                      }
                    }}
                  >
                    <BrainCircuit size={17} />
                    {showPredictionForm ? "Close prediction form" : "Predict Attrition Risk"}
                  </button>
                </section>
              )}

              {showPredictionForm && isAnalyticsRole && (
                <AttritionPredictionForm
                  employees={employees}
                  selectedEmployeeId={selectedEmployeeId}
                  setSelectedEmployeeId={setSelectedEmployeeId}
                  inputs={predictionInputs}
                  setInputs={setPredictionInputs}
                  onSubmit={submitAttritionPrediction}
                  loading={predictionLoading}
                  error={predictionError}
                  result={predictionResult}
                />
              )}

              <EmployeeTable
                employees={employees}
                loading={loading}
                search={search}
                setSearch={setSearch}
                canAdd={isAnalyticsRole}
                onRefresh={loadDashboard}
              />
            </>
          )}


          {activeView === "attendance" && (
            <section className="table-card attendance-card">
              <div className="table-heading">
                <div>
                  <h2>Attendance records</h2>
                  <p className="muted">
                    Records retrieved from the authenticated Attendance API.
                  </p>
                </div>
                <button
                  className="secondary-btn"
                  type="button"
                  onClick={loadAttendance}
                  disabled={attendanceLoading}
                >
                  <RefreshCw size={16} />
                  Refresh
                </button>
              </div>

              {attendanceError && (
                <div className="alert error">{String(attendanceError)}</div>
              )}
              {attendanceMessage && (
                <div className="alert success">{attendanceMessage}</div>
              )}

              <div className="attendance-actions">
                <label>
                  Employee
                  <select
                    value={attendanceEmployeeId}
                    onChange={(event) => setAttendanceEmployeeId(event.target.value)}
                  >
                    <option value="">Select employee</option>
                    {employees.map((employee) => (
                      <option key={employee.id} value={employee.id}>
                        {employee.full_name} (ID: {employee.id})
                      </option>
                    ))}
                  </select>
                </label>

                <button
                  className="primary-btn"
                  type="button"
                  disabled={attendanceLoading || !attendanceEmployeeId}
                  onClick={() => recordAttendance("check-in")}
                >
                  <LogIn size={16} /> Check In
                </button>

                <button
                  className="secondary-btn"
                  type="button"
                  disabled={attendanceLoading || !attendanceEmployeeId}
                  onClick={() => recordAttendance("check-out")}
                >
                  <LogOutIcon size={16} /> Check Out
                </button>
              </div>

              {attendanceSummary && (
                <div className="attendance-summary">
                  {Object.entries(attendanceSummary).map(([key, value]) => (
                    <article className="stat-card" key={key}>
                      <div className="stat-note">{key.replaceAll("_", " ")}</div>
                      <div className="stat-value">
                        {typeof value === "number" ? value.toFixed(2).replace(/\.00$/, "") : String(value ?? "—")}
                      </div>
                    </article>
                  ))}
                </div>
              )}

              {attendanceLoading && attendanceRecords.length === 0 ? (
                <p className="muted">Loading attendance records...</p>
              ) : attendanceRecords.length === 0 ? (
                <EmptyState message="No attendance records found." />
              ) : (
                <div className="table-scroll">
                  <table>
                    <thead>
                      <tr>
                        <th>Employee</th>
                        <th>Date</th>
                        <th>Check in</th>
                        <th>Check out</th>
                        <th>Shift</th>
                        <th>Status</th>
                      </tr>
                    </thead>
                    <tbody>
                      {attendanceRecords.map((record) => {
                        const employee = employees.find(
                          (item) => item.id === record.employee_id
                        );

                        return (
                          <tr key={record.id}>
                            <td>{employee?.full_name || `Employee #${record.employee_id}`}</td>
                            <td>{record.attendance_date || "—"}</td>
                            <td>{record.check_in ? formatDate(record.check_in) : "—"}</td>
                            <td>{record.check_out ? formatDate(record.check_out) : "—"}</td>
                            <td>{record.shift_name || "General"}</td>
                            <td>{record.status || "—"}</td>
                          </tr>
                        );
                      })}
                    </tbody>
                  </table>
                </div>
              )}
            </section>
          )}

          {activeView === "departments" && (
            <section className="department-grid">
              {[...new Set(employees.map((employee) => employee.department).filter(Boolean))].map((department) => {
                const departmentEmployees = employees.filter((employee) => employee.department === department);
                return (
                  <article className="department-card" key={department}>
                    <div className="department-icon"><Building2 size={21} /></div>
                    <h3>{department}</h3>
                    <p>{departmentEmployees.length} employee(s)</p>
                    <span className="muted">{departmentEmployees.filter((employee) => employee.employment_status === "ACTIVE").length} active</span>
                  </article>
                );
              })}
              {departments === 0 && <EmptyState message="No department records available." />}
            </section>
          )}

          {activeView === "insights" && (
            isAnalyticsRole ? (
              <>
                <div className="demo-notice">
                  <CircleAlert size={18} />
                  <div>
                    <strong>Experimental model</strong>
                    <p>Predictions use synthetic demo data and are not validated for real employment decisions.</p>
                  </div>
                </div>

                <RiskCards counts={riskCounts} total={predictions.length} />

                <section className="chart-grid">
                  <article className="chart-card">
                    <div className="chart-heading">
                      <div><h2>Risk distribution</h2><p>Saved predictions by risk category</p></div>
                    </div>
                    {predictions.length === 0 ? <EmptyState message="No saved predictions yet." /> : (
                      <div className="chart-body">
                        <ResponsiveContainer width="100%" height={260}>
                          <PieChart>
                            <Pie data={riskChartData} dataKey="value" nameKey="name" cx="50%" cy="50%" innerRadius={63} outerRadius={94} paddingAngle={4}>
                              {riskChartData.map((entry) => (
                                <Cell key={entry.level} fill={RISK_COLORS[entry.level]} />
                              ))}
                            </Pie>
                            <Tooltip />
                          </PieChart>
                        </ResponsiveContainer>
                        <div className="chart-legend">
                          {riskChartData.map((entry) => (
                            <div key={entry.level}>
                              <span className="legend-dot" style={{ background: RISK_COLORS[entry.level] }} />
                              <span>{entry.name}</span><strong>{entry.value}</strong>
                            </div>
                          ))}
                        </div>
                      </div>
                    )}
                  </article>

                  <article className="chart-card">
                    <div className="chart-heading">
                      <div><h2>Prediction activity</h2><p>Daily saved predictions, up to seven dates</p></div>
                    </div>
                    {historyChartData.length === 0 ? <EmptyState message="Activity appears after predictions are saved." /> : (
                      <div className="bar-chart-body">
                        <ResponsiveContainer width="100%" height={310}>
                          <BarChart data={historyChartData} margin={{ top: 10, right: 8, left: -18, bottom: 5 }}>
                            <CartesianGrid strokeDasharray="3 3" vertical={false} stroke="#edf0f5" />
                            <XAxis dataKey="date" tick={{ fontSize: 11, fill: "#8390a3" }} />
                            <YAxis allowDecimals={false} tick={{ fontSize: 11, fill: "#8390a3" }} />
                            <Tooltip />
                            <Bar dataKey="HIGH" stackId="risk" fill={RISK_COLORS.HIGH} radius={[0, 0, 0, 0]} />
                            <Bar dataKey="MEDIUM" stackId="risk" fill={RISK_COLORS.MEDIUM} />
                            <Bar dataKey="LOW" stackId="risk" fill={RISK_COLORS.LOW} radius={[4, 4, 0, 0]} />
                          </BarChart>
                        </ResponsiveContainer>
                      </div>
                    )}
                  </article>
                </section>

                <PredictionHistory predictions={predictions} loading={loading} />
              </>
            ) : (
              <div className="alert error">Workforce insights are available to authorized HR and Admin users.</div>
            )
          )}

          <footer className="page-footer">
            WorkForce AI Pro <span>•</span> HR Attrition Prediction &amp; Workforce Intelligence
          </footer>
        </div>
      </main>
    </div>
  );
}

function StatCard({ icon, label, value, note }) {
  return (
    <article className="stat-card">
      <div className="stat-top"><span>{label}</span><span className="stat-icon">{icon}</span></div>
      <div className="stat-value">{value}</div>
      <div className="stat-note">{note}</div>
    </article>
  );
}

function RiskCards({ counts, total }) {
  return (
    <section className="risk-grid">
      <article className="risk-card total">
        <div className="risk-card-top"><span>Total predictions</span><span className="risk-card-icon"><History size={18} /></span></div>
        <div className="risk-number">{total}</div>
        <p>Saved prediction records</p>
      </article>
      {["HIGH", "MEDIUM", "LOW"].map((level) => (
        <article className={`risk-card ${level.toLowerCase()}`} key={level}>
          <div className="risk-card-top">
            <span>{level.charAt(0) + level.slice(1).toLowerCase()} risk</span>
            <span className="risk-card-icon"><Activity size={18} /></span>
          </div>
          <div className="risk-number">{counts[level]}</div>
          <p>{total ? `${((counts[level] / total) * 100).toFixed(1)}% of saved predictions` : "No predictions yet"}</p>
        </article>
      ))}
    </section>
  );
}



function EmployeeTable({ employees, loading, search, setSearch, canAdd = false, onRefresh }) {
  const [employeeToDeactivate, setEmployeeToDeactivate] = useState(null);
  const [editing, setEditing] = useState(null);
  const [saving, setSaving] = useState(false);
  const [message, setMessage] = useState("");
  const [error, setError] = useState("");
  const [showAddForm, setShowAddForm] = useState(false);
  const [adding, setAdding] = useState(false);
  const [newEmployee, setNewEmployee] = useState({
    employee_code: "",
    full_name: "",
    email: "",
    phone: "",
    department: "",
    job_title: "",
    joining_date: "",
  });

  async function createEmployee(event) {
    event.preventDefault();
    setAdding(true);
    setMessage("");
    setError("");

    try {
      const payload = {
        employee_code: newEmployee.employee_code.trim(),
        full_name: newEmployee.full_name.trim(),
        email: newEmployee.email.trim(),
        phone: newEmployee.phone.trim() || null,
        department: newEmployee.department.trim(),
        job_title: newEmployee.job_title.trim(),
      };

      if (newEmployee.joining_date) {
        payload.joining_date = newEmployee.joining_date;
      }

      await client.post("/employees/", payload);

      setMessage("Employee created successfully.");
      setNewEmployee({
        employee_code: "",
        full_name: "",
        email: "",
        phone: "",
        department: "",
        job_title: "",
        joining_date: "",
      });
      setShowAddForm(false);

      if (onRefresh) await onRefresh();
    } catch (err) {
      const detail = err.response?.data?.detail;
      setError(
        Array.isArray(detail)
          ? detail.map((item) => item.msg).join(", ")
          : detail || "Unable to create employee. Check the fields and your Admin/HR access."
      );
    } finally {
      setAdding(false);
    }
  }

  async function saveEmployee(event) {
    event.preventDefault();
    if (!editing) return;

    setSaving(true);
    setMessage("");
    setError("");

    try {
      const token = localStorage.getItem("wf_token");
      await axios.patch(
        `${API}/employees/${editing.id}`,
        {
          department: editing.department,
          job_title: editing.job_title,
        },
        { headers: { Authorization: `Bearer ${token}` } }
      );

      setMessage("Employee details updated successfully.");
      setEditing(null);
      if (onRefresh) await onRefresh();
    } catch (err) {
      setError(
        err.response?.data?.detail ||
        "Unable to update employee. Please check your Admin/HR access."
      );
    } finally {
      setSaving(false);
    }
  }

  async function deactivateEmployee(employee) {
    setSaving(true);
    setMessage("");
    setError("");

    try {
      await client.patch(`/employees/${employee.id}/deactivate`, {});

      setMessage(`${employee.full_name} was deactivated successfully.`);
      setEmployeeToDeactivate(null);
      if (onRefresh) await onRefresh();
    } catch (err) {
      setError(
        err.response?.data?.detail ||
        "Unable to deactivate employee. Please check your Admin/HR access."
      );
    } finally {
      setSaving(false);
    }
  }

  return (
    <section className="table-card">
      <div className="table-heading">
        <div>
          <h2>Employee directory</h2>
          <p className="muted">Live data from the FastAPI employee endpoint.</p>
        </div>
        <div className="employee-heading-actions">
          <div className="search-box">
            <Search size={17} />
            <input
              value={search}
              onChange={(event) => setSearch(event.target.value)}
              placeholder="Search employees..."
            />
          </div>
          {canAdd && (
            <button
              className="primary-btn employee-add-btn"
              type="button"
              disabled={adding}
              onClick={() => {
                setShowAddForm((previous) => !previous);
                setEditing(null);
                setMessage("");
                setError("");
              }}
            >
              {showAddForm ? "Cancel add" : "+ Add Employee"}
            </button>
          )}
        </div>
      </div>

      {message && <p className="employee-inline-success">{message}</p>}
      {error && <p className="employee-inline-error">{error}</p>}
      {employeeToDeactivate && (
        <div className="deactivate-confirm-panel" role="alert">
          <div>
            <h3>Deactivate employee?</h3>
            <p>
              Are you sure you want to deactivate{" "}
              <strong>{employeeToDeactivate.full_name}</strong>?
              Their status will change to INACTIVE.
            </p>
          </div>
          <div className="employee-inline-buttons">
            <button
              className="employee-action-btn danger"
              type="button"
              disabled={saving}
              onClick={() => deactivateEmployee(employeeToDeactivate)}
            >
              {saving ? "Deactivating..." : "Yes, deactivate"}
            </button>
            <button
              className="employee-action-btn"
              type="button"
              disabled={saving}
              onClick={() => setEmployeeToDeactivate(null)}
            >
              Cancel
            </button>
          </div>
        </div>
      )}


      {showAddForm && canAdd && (
        <form className="employee-inline-form" onSubmit={createEmployee}>
          <h3>Add a new employee</h3>
          <div className="employee-inline-fields">
            <label>
              Employee code *
              <input
                required
                maxLength={20}
                value={newEmployee.employee_code}
                onChange={(event) => setNewEmployee({ ...newEmployee, employee_code: event.target.value })}
                placeholder="e.g. EMP002"
              />
            </label>
            <label>
              Full name *
              <input
                required
                maxLength={120}
                value={newEmployee.full_name}
                onChange={(event) => setNewEmployee({ ...newEmployee, full_name: event.target.value })}
                placeholder="Employee full name"
              />
            </label>
            <label>
              Email address *
              <input
                required
                type="email"
                value={newEmployee.email}
                onChange={(event) => setNewEmployee({ ...newEmployee, email: event.target.value })}
                placeholder="employee@company.com"
              />
            </label>
            <label>
              Phone
              <input
                maxLength={20}
                value={newEmployee.phone}
                onChange={(event) => setNewEmployee({ ...newEmployee, phone: event.target.value })}
                placeholder="Optional phone number"
              />
            </label>
            <label>
              Department *
              <input
                required
                maxLength={100}
                value={newEmployee.department}
                onChange={(event) => setNewEmployee({ ...newEmployee, department: event.target.value })}
                placeholder="e.g. Engineering"
              />
            </label>
            <label>
              Job title *
              <input
                required
                maxLength={100}
                value={newEmployee.job_title}
                onChange={(event) => setNewEmployee({ ...newEmployee, job_title: event.target.value })}
                placeholder="e.g. Software Developer"
              />
            </label>
            <label>
              Joining date
              <input
                type="date"
                value={newEmployee.joining_date}
                onChange={(event) => setNewEmployee({ ...newEmployee, joining_date: event.target.value })}
              />
            </label>
          </div>
          <div className="employee-inline-buttons">
            <button className="primary-btn" type="submit" disabled={adding}>
              {adding ? "Creating employee..." : "Save employee"}
            </button>
            <button
              className="employee-action-btn"
              type="button"
              disabled={adding}
              onClick={() => setShowAddForm(false)}
            >
              Cancel
            </button>
          </div>
        </form>
      )}

      {editing && (
        <form className="employee-inline-form" onSubmit={saveEmployee}>
          <h3>Edit employee: {editing.full_name}</h3>
          <div className="employee-inline-fields">
            <label>
              Department
              <input
                required
                value={editing.department || ""}
                onChange={(event) =>
                  setEditing({ ...editing, department: event.target.value })
                }
              />
            </label>
            <label>
              Job title
              <input
                required
                value={editing.job_title || ""}
                onChange={(event) =>
                  setEditing({ ...editing, job_title: event.target.value })
                }
              />
            </label>
          </div>
          <div className="employee-inline-buttons">
            <button className="employee-action-btn" type="submit" disabled={saving}>
              {saving ? "Saving..." : "Save changes"}
            </button>
            <button
              className="employee-action-btn"
              type="button"
              disabled={saving}
              onClick={() => setEditing(null)}
            >
              Cancel
            </button>
          </div>
        </form>
      )}

      <div className="table-wrap">
        <table>
          <thead>
            <tr>
              <th>EMPLOYEE</th>
              <th>DEPARTMENT</th>
              <th>JOB TITLE</th>
              <th>STATUS</th>
              <th>ACTIONS</th>
            </tr>
          </thead>
          <tbody>
            {employees.map((employee) => (
              <tr key={employee.id}>
                <td>
                  <div className="employee-cell">
                    <div className="employee-avatar">
                      {employee.full_name?.charAt(0)?.toUpperCase() || "?"}
                    </div>
                    <div>
                      <strong>{employee.full_name}</strong>
                      <span>{employee.employee_code} · {employee.email}</span>
                    </div>
                  </div>
                </td>
                <td>{employee.department || "—"}</td>
                <td>{employee.job_title || "—"}</td>
                <td>
                  <span className={`status ${employee.employment_status === "ACTIVE" ? "active" : "inactive"}`}>
                    {employee.employment_status}
                  </span>
                </td>
                <td>
                  <div className="employee-actions">
                    <button
                      className="employee-action-btn"
                      type="button"
                      disabled={saving}
                      onClick={() => {
                        setError("");
                        setMessage("");
                        setEditing({ ...employee });
                      }}
                    >
                      Edit
                    </button>
                    {employee.employment_status === "ACTIVE" && (
                      <button
                        className="employee-action-btn danger"
                        type="button"
                        disabled={saving}
                        onClick={() => {
                          setEmployeeToDeactivate(employee);
                          setMessage("");
                          setError("");
                        }}
                      >
                        Deactivate
                      </button>
                    )}
                  </div>
                </td>
              </tr>
            ))}
            {!loading && employees.length === 0 && (
              <tr>
                <td colSpan="5"><EmptyState message="No employee records found." /></td>
              </tr>
            )}
            {loading && (
              <tr>
                <td colSpan="5" className="empty-state">Loading employee records...</td>
              </tr>
            )}
          </tbody>
        </table>
      </div>
      <div className="table-footer">
        Showing {employees.length} record(s) · Connected to WorkForce AI Pro API
      </div>
    </section>
  );
}

function PredictionHistory({ predictions, loading, compact = false }) {
  return (
    <section className="table-card history-card">
      <div className="table-heading">
        <div>
          <h2>{compact ? "Recent predictions" : "Prediction history"}</h2>
          <p className="muted">Saved records from the attrition history API.</p>
        </div>
        <span className="history-count"><Clock3 size={14} />{predictions.length} record(s)</span>
      </div>
      <div className="table-wrap">
        <table>
          <thead><tr><th>RECORD</th><th>EMPLOYEE ID</th><th>RISK LEVEL</th><th>PROBABILITY</th><th>CREATED AT</th></tr></thead>
          <tbody>
            {predictions.map((prediction) => {
              const level = riskLabel(prediction.risk_level);
              return (
                <tr key={prediction.id}>
                  <td>#{prediction.id}</td>
                  <td>{prediction.employee_id}</td>
                  <td><span className={`risk-badge ${level.toLowerCase()}`}>{level}</span></td>
                  <td><div className="probability-cell">
                    <span>{(Number(prediction.risk_probability) * 100).toFixed(1)}%</span>
                    <div className="probability-track"><span style={{ width: `${Math.max(0, Math.min(100, Number(prediction.risk_probability) * 100))}%`, background: RISK_COLORS[level] || "#8b95a5" }} /></div>
                  </div></td>
                  <td>{formatDate(prediction.created_at)}</td>
                </tr>
              );
            })}
            {!loading && predictions.length === 0 && (
              <tr><td colSpan="5"><EmptyState message="No saved predictions are available for this account." /></td></tr>
            )}
            {loading && <tr><td colSpan="5" className="empty-state">Loading prediction history...</td></tr>}
          </tbody>
        </table>
      </div>
      <div className="table-footer">
        Experimental estimates from synthetic demo data; not validated for real employment decisions.
      </div>
    </section>
  );
}

function EmptyState({ message }) {
  return <div className="empty-state"><ChartNoAxesCombined size={25} /><span>{message}</span></div>;
}


function AttritionPredictionForm({
  employees,
  selectedEmployeeId,
  setSelectedEmployeeId,
  inputs,
  setInputs,
  onSubmit,
  loading,
  error,
  result,
}) {
  const update = (field, value) =>
    setInputs((previous) => ({ ...previous, [field]: value }));

  const level = String(result?.risk_level || "UNKNOWN").toUpperCase();
  const probability = Number(result?.risk_probability);

  return (
    <section className="prediction-form-card">
      <div className="table-heading">
        <div>
          <h2>Predict employee attrition risk</h2>
          <p className="muted">Enter the employee's current work-related information.</p>
        </div>
        <span className="risk-badge medium">DEMO MODEL</span>
      </div>

      {employees.length === 0 ? (
        <EmptyState message="Add an employee before generating a prediction." />
      ) : (
        <form className="prediction-form" onSubmit={onSubmit}>
          <label>
            Employee
            <select
              required
              value={selectedEmployeeId}
              onChange={(event) => setSelectedEmployeeId(event.target.value)}
            >
              {employees.map((employee) => (
                <option key={employee.id} value={employee.id}>
                  {employee.full_name} — {employee.employee_code || `ID ${employee.id}`}
                </option>
              ))}
            </select>
          </label>

          <label>
            Job satisfaction (1–4)
            <select
              value={inputs.job_satisfaction}
              onChange={(event) => update("job_satisfaction", event.target.value)}
            >
              {[1, 2, 3, 4].map((value) => (
                <option key={value} value={value}>{value}</option>
              ))}
            </select>
          </label>

          <label>
            Work-life balance (1–4)
            <select
              value={inputs.work_life_balance}
              onChange={(event) => update("work_life_balance", event.target.value)}
            >
              {[1, 2, 3, 4].map((value) => (
                <option key={value} value={value}>{value}</option>
              ))}
            </select>
          </label>

          <label>
            Years at company
            <input type="number" min="0" max="60" required
              value={inputs.years_at_company}
              onChange={(event) => update("years_at_company", event.target.value)} />
          </label>

          <label>
            Monthly income (₹)
            <input type="number" min="0" max="10000000" required
              value={inputs.monthly_income}
              onChange={(event) => update("monthly_income", event.target.value)} />
          </label>

          <label>
            Training hours
            <input type="number" min="0" max="1000" required
              value={inputs.training_hours}
              onChange={(event) => update("training_hours", event.target.value)} />
          </label>

          <label className="overtime-option">
            <input type="checkbox" checked={inputs.overtime}
              onChange={(event) => update("overtime", event.target.checked)} />
            Employee works overtime
          </label>

          {error && (
            <div className="alert error prediction-message">
              <AlertCircle size={17} />
              <span>{String(error)}</span>
            </div>
          )}

          <button className="primary-btn prediction-submit" type="submit"
            disabled={loading || !selectedEmployeeId}>
            <BrainCircuit size={17} />
            {loading ? "Generating prediction..." : "Generate prediction"}
          </button>
        </form>
      )}

      {result && (
        <div className="prediction-result">
          <span className="eyebrow">PREDICTION RESULT</span>
          <h3>
            {employees.find((employee) =>
              String(employee.id) === String(selectedEmployeeId)
            )?.full_name || "Selected employee"}
          </h3>
          <div className="prediction-result-grid">
            <div>
              <span>Risk category</span>
              <strong className={`risk-badge ${level.toLowerCase()}`}>{level}</strong>
            </div>
            <div>
              <span>Model probability</span>
              <strong>{Number.isFinite(probability)
                ? `${(probability * 100).toFixed(1)}%` : "—"}</strong>
            </div>
          </div>
          <p className="muted">
            {result.disclaimer ||
              "Experimental estimate only; not validated for real employment decisions."}
          </p>
        </div>
      )}
    </section>
  );
}

export default App;
