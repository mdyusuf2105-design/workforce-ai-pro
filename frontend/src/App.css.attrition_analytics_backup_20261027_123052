/* Attendance Reports workspace */
.attendance-reports-workspace {
  display: grid;
  gap: 22px;
}

.attendance-report-stats {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 16px;
}

.attendance-report-stat {
  display: flex;
  flex-direction: column;
  gap: 9px;
  padding: 20px;
  border: 1px solid var(--border-color, #e5e7eb);
  border-radius: 16px;
  background: var(--card-bg, #fff);
  min-width: 0;
}

.attendance-report-stat > span,
.attendance-report-stat small {
  color: var(--muted-text, #64748b);
  font-size: 13px;
}

.attendance-report-stat strong {
  color: var(--text-color, #172033);
  font-size: 28px;
  overflow-wrap: anywhere;
}

.attendance-report-insights {
  display: flex;
  flex-wrap: wrap;
  gap: 12px 24px;
  padding: 16px 18px;
  border: 1px solid var(--border-color, #e5e7eb);
  border-radius: 14px;
  background: var(--card-bg, #fff);
  font-size: 13px;
}

.attendance-report-insights span {
  color: var(--muted-text, #64748b);
}

.attendance-report-insights strong {
  color: var(--text-color, #172033);
}

.attendance-report-filters {
  display: flex;
  align-items: end;
  flex-wrap: wrap;
  gap: 14px;
  padding: 18px;
  border: 1px solid var(--border-color, #e5e7eb);
  border-radius: 16px;
  background: var(--card-bg, #fff);
}

.attendance-report-filters label {
  display: grid;
  gap: 7px;
  min-width: 150px;
  flex: 1;
  color: var(--muted-text, #64748b);
  font-size: 12px;
  font-weight: 600;
}

.attendance-report-filters input {
  width: 100%;
  min-height: 42px;
  box-sizing: border-box;
  padding: 9px 11px;
  border: 1px solid var(--border-color, #d1d5db);
  border-radius: 9px;
  background: var(--input-bg, #fff);
  color: var(--text-color, #172033);
  font: inherit;
}

.attendance-report-table-card {
  min-width: 0;
  overflow: hidden;
  border: 1px solid var(--border-color, #e5e7eb);
  border-radius: 16px;
  background: var(--card-bg, #fff);
}

.attendance-report-table-heading,
.attendance-report-pagination {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  padding: 18px 20px;
}

.attendance-report-table-heading {
  border-bottom: 1px solid var(--border-color, #e5e7eb);
}

.attendance-report-table-heading h3 {
  margin: 0 0 5px;
  color: var(--text-color, #172033);
}

.attendance-report-table-heading p,
.attendance-report-pagination > span {
  margin: 0;
  color: var(--muted-text, #64748b);
  font-size: 13px;
}

.attendance-report-table-scroll {
  width: 100%;
  overflow-x: auto;
}

.attendance-report-table {
  width: 100%;
  border-collapse: collapse;
  white-space: nowrap;
}

.attendance-report-table th,
.attendance-report-table td {
  padding: 14px 16px;
  border-bottom: 1px solid var(--border-color, #e5e7eb);
  text-align: left;
  font-size: 13px;
}

.attendance-report-table th {
  background: var(--table-header-bg, #f8fafc);
  color: var(--muted-text, #64748b);
  font-size: 11px;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: .04em;
}

.attendance-report-table td {
  color: var(--text-color, #172033);
}

.attendance-report-table td:first-child {
  min-width: 145px;
}

.attendance-report-table td:first-child strong,
.attendance-report-table td:first-child small {
  display: block;
}

.attendance-report-table td:first-child small {
  margin-top: 4px;
  color: var(--muted-text, #64748b);
}

.attendance-report-status,
.attendance-punctuality {
  display: inline-flex;
  align-items: center;
  padding: 5px 9px;
  border-radius: 999px;
  background: var(--soft-bg, #f1f5f9);
  color: var(--text-color, #334155);
  font-size: 12px;
}

.attendance-punctuality.late {
  background: #fff0ee;
  color: #b42318;
}

.attendance-report-empty {
  padding: 36px 16px !important;
  color: var(--muted-text, #64748b) !important;
  text-align: center !important;
}

.attendance-report-pagination {
  border-top: 1px solid var(--border-color, #e5e7eb);
}

.attendance-report-pagination > div {
  display: flex;
  gap: 8px;
}

@media (max-width: 900px) {
  .attendance-report-stats {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
}

@media (max-width: 600px) {
  .attendance-report-stats {
    grid-template-columns: 1fr;
  }

  .attendance-report-table-heading,
  .attendance-report-pagination {
    align-items: flex-start;
    flex-direction: column;
  }

  .attendance-report-pagination > div {
    width: 100%;
  }

  .attendance-report-pagination button {
    flex: 1;
  }
}
